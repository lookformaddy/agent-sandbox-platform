# Agent Sandbox Platform — environment template
# Copy to .env and adjust. No secrets are needed: execution is simulated
# and deterministic, so the platform runs fully offline.
ASP_DEFAULT_CPU_MS_BUDGET=60000
ASP_DEFAULT_MEMORY_MB_BUDGET=512
ASP_DEFAULT_WALL_MS_PER_CALL=5000
ASP_DEFAULT_MAX_CALLS=100
ASP_DEFAULT_NETWORK_MODE=allowlist
ASP_DEFAULT_FS_ROOTS=/workspace
ASP_DEFAULT_NETWORK_ALLOWLIST=api.example.com,objects.example.com
ASP_DEFAULT_MAX_RETRIES=2
ASP_RETRY_BACKOFF_BASE_MS=100
ASP_SEED=42
ASP_COST_PER_CALL_LOW=0.0001
ASP_COST_PER_CALL_MEDIUM=0.0005
ASP_COST_PER_CALL_HIGH=0.002
ASP_COST_PER_CPU_MS=0.0000001
ASP_TENANT_COST_CAP_USD=10.00
ASP_TENANT_CALL_CAP=10000
ASP_HOST=0.0.0.0
ASP_PORT=8000
